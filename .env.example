# ===== BluCheck - configurazione =====
# Copia questo file in .env e compila i valori.

# Indirizzo pubblico dell'app (senza barra finale): serve per i link nelle email e per il ritorno da Stripe
BASE_URL=https://blucheck.tuodominio.it
PORT=3030
NODE_ENV=production
TZ=Europe/Rome

# Primo superuser (creato all'avvio solo se non ne esiste già uno). Poi puoi togliere la password da qui.
SUPERUSER_EMAIL=tuo@email.it
SUPERUSER_PASSWORD=cambia-questa-password-lunga
SUPERUSER_NOME=Alessandro Fierro

# Giorni di prova proposti quando abiliti una nuova azienda
PROVA_GIORNI=30

# Contatti mostrati sul sito e nell'app quando il pagamento online non è attivo
CONTATTO_EMAIL=info@tuodominio.it
CONTATTO_TELEFONO=
CONTATTO_SITO=

# ----- Pagamenti online (Stripe: carta, Google Pay, Apple Pay, PayPal) -----
# Dashboard Stripe > Sviluppatori > Chiavi API. Usa prima le chiavi di test (sk_test_...).
STRIPE_SECRET_KEY=
# Dashboard Stripe > Sviluppatori > Webhook > endpoint https://blucheck.tuodominio.it/api/stripe/webhook
# eventi: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# ----- Email (avvisi di scadenza, credenziali, pagamenti) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BluCheck <noreply@tuodominio.it>"
# Dove ricevi tu gli avvisi (separati da virgola). Se vuoto: le email dei superuser.
ALERT_EMAIL=
