# ===== BluCheck - configurazione =====
# Copia questo file in .env e compila i valori. Le password e le chiavi stanno solo nel .env del server.

# Indirizzo pubblico dell'app (senza barra finale): serve per i link nelle email e per il ritorno dai pagamenti
BASE_URL=https://blucheck.blucodeinformatica.it
PORT=3030
NODE_ENV=production
TZ=Europe/Rome

# Primo superuser (creato all'avvio solo se non ne esiste già uno). Poi puoi togliere la password da qui.
SUPERUSER_EMAIL=tuo@email.it
SUPERUSER_PASSWORD=cambia-questa-password-lunga
SUPERUSER_NOME=Alessandro Fierro

# Contatti mostrati nell'app, nelle email e sulla ricevuta
SUPPORT_EMAIL=info@blucodeinformatica.it
SUPPORT_PHONE=379 233 3492
CONTATTO_SITO=https://blucodeinformatica.it

# ----- Email (avvisi di scadenza, credenziali, ricevute) -----
# BluCode: Aruba smtps.aruba.it, porta 465 (SSL), utente = casella intera.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@blucodeinformatica.it
SMTP_PASSWORD=
SMTP_FROM="BluCheck · BluCode Informatica <info@blucodeinformatica.it>"
# Casella BluCode che riceve nuove prove, copie degli avvisi, riepilogo settimanale e XML delle fatture
ADMIN_NOTIFY_EMAIL=blucheck@blucodeinformatica.it

# ----- Prova gratuita dal sito (POST /api/public/prova, contratto comune BluCode) -----
# La prova dura TRIAL_DAYS giorni sul piano più grande; 0 = iscrizioni chiuse. Finita la prova l'accesso si sospende.
WEBSITE_URL=https://blucodeinformatica.it
TRIAL_DAYS=7
TERMS_VERSION=1.0
TERMS_URL=https://blucodeinformatica.it/termini/
TERMS_PDF_URL=https://blucodeinformatica.it/termini/termini-di-utilizzo-v1.0.pdf

# ----- Pagamenti degli abbonamenti (contratto comune: carta, PayPal, bonifico) -----
# Metodi proposti: compaiono solo quelli con le chiavi qui sotto. Il bonifico funziona subito con l'IBAN.
PAGAMENTI_METODI=carta,paypal,bonifico
# Carta (anche Google Pay e Apple Pay) con Stripe Checkout. Webhook: https://blucheck.blucodeinformatica.it/api/pagamenti/webhook/stripe
# eventi checkout.session.completed e checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal Business (REST app). Webhook: https://blucheck.blucodeinformatica.it/api/pagamenti/webhook/paypal, evento PAYMENT.CAPTURE.COMPLETED
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# Bonifico: l'abbonamento si rinnova quando confermi l'accredito dal pannello
BONIFICO_INTESTATARIO=BluCode Informatica
BONIFICO_IBAN=

# ----- Fattura dell'abbonamento (XML FatturaPA + proforma PDF) -----
CEDENTE_DENOMINAZIONE=BluCode Informatica
CEDENTE_PIVA=05357210755
CEDENTE_CF=
CEDENTE_INDIRIZZO=Via Napoli 78
CEDENTE_CAP=73036
CEDENTE_COMUNE=Muro Leccese
CEDENTE_PROVINCIA=LE
REGIME_FISCALE=RF19
BOLLO_A_CARICO=cliente
FATTURE_SEZIONALE=BC
# manuale = l'XML arriva per email ad ADMIN_NOTIFY_EMAIL e si carica a mano sul portale dell'Agenzia
FATTURE_INVIO=manuale

# ----- BluCode Console -----
# Chiave per GET /api/console/riepilogo (openssl rand -hex 32). Vuota = funzione spenta.
CONSOLE_API_KEY=
# Seconda chiave per cambiare le credenziali del superuser dalla Console. Vuota = funzione spenta.
CONSOLE_ADMIN_KEY=
CONSOLE_SUPERADMIN_EMAIL=
